# Keep real credentials in a local file; CLI loads only --env-file.
MODEL_ID=your-openai-compatible-model-id
MODEL_BASE_URL=https://your-existing-model-endpoint/v1
MODEL_API_KEY=replace-locally
# Required for raw research. Fill from your provider's current CNY price schedule.
# Input price should bound cache misses; output price bounds all generated tokens.
MODEL_INPUT_CNY_PER_MILLION=
MODEL_OUTPUT_CNY_PER_MILLION=
MODEL_PRICE_SOURCE=
MODEL_PRICE_AS_OF=
# Public HTTP/search works without these; no private data adapter is connected yet.
DATA_API_KEY=
DATA_BASE_URL=
YANTRA_RUNS_DIR=runs
YANTRA_MODE=real-model
# ADK raw mode: JSON array of files/directories/URLs; legacy manifest mode remains separate.
YANTRA_RAW_MATERIALS=
YANTRA_MARKET=
YANTRA_SECURITY_CODE=
YANTRA_EXCHANGE=
YANTRA_TRADING_CURRENCY=
YANTRA_CONFIRMATION_MODE=autonomous
YANTRA_FRAMEWORK=auto
# Legacy offline-demo only:
YANTRA_MATERIALS_DIR=
# Optional external Tesseract language directory, containing chi_sim and eng:
# TESSDATA_PREFIX=
# v0.2.1 capability configuration; --config overrides this path.
# YANTRA_CONFIG=/absolute/path/to/.yantra/config.json
# Profiles reference environment variable NAMES, never literal credentials.
# These are placeholders for the local model profile examples (edit before use):
# LOCAL_MODEL_API_KEY=replace-locally
# LOCAL_VISION_API_KEY=replace-locally
# Example MCP headers_env={"Authorization":"MCP_AUTHORIZATION"} expects a complete header:
# MCP_AUTHORIZATION=Bearer replace-locally
