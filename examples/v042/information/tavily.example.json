{
  "description": "Tavily basic 网页搜索：寻找公告、财报和原始地址。保留完整结果后通过现有公开获取流程读取原文；摘要不能代替数值依据。",
  "command": [
    ".venv/bin/python",
    "-m",
    "yantra.information",
    "tavily"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "max_results": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      },
      "topic": {
        "enum": [
          "general",
          "news"
        ]
      },
      "search_depth": {
        "const": "basic"
      },
      "include_domains": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+$"
        },
        "maxItems": 10
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  },
  "env_refs": {
    "TAVILY_API_KEY": "TAVILY_API_KEY"
  },
  "roles": [
    "finance",
    "thesis",
    "verification"
  ],
  "timeout_seconds": 60,
  "cost_cny": 0,
  "cost_kind": "service",
  "enabled": false,
  "information_provider": "tavily",
  "cost_status": "unknown"
}
